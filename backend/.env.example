# ---------- BACKEND (Spring Boot) ----------
# Copia este archivo a backend/.env (que NO se versiona) y rellena tus valores reales.
# Valores de ejemplo, claramente ficticios:
SUPABASE_DB_URL=jdbc:postgresql://db.PROYECTO-EJEMPLO.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=cambia-esta-clave-de-ejemplo

# Opcionales (valores por defecto entre paréntesis)
# SESSION_COOKIE_SECURE=false   # (true) pon false SOLO en desarrollo local sobre http
# SESSION_TIMEOUT=30m           # (30m) inactividad máxima de la sesión
# LOGIN_MAX_INTENTOS=5          # (5)  fallos por correo antes de bloquear
# LOGIN_VENTANA_MINUTOS=15      # (15)
# LOGIN_BLOQUEO_MINUTOS=15      # (15)
# JPA_SHOW_SQL=false            # (false)

# Datos del prestamista que figuran en el contrato. Si no se definen, el contrato los declara como "no definidos".
# CONTRATO_PRESTAMISTA_DENOMINACION=Préstamos Castillo
# CONTRATO_PRESTAMISTA_RUC=
# CONTRATO_PRESTAMISTA_DOMICILIO=
# CONTRATO_PRESTAMISTA_REPRESENTANTE=

# Caja y reposiciones: Hermes es SIMULADO de forma permanente y viene activo por defecto (cualquier código de 8 dígitos
# se acepta; 00000000 = inválido, 99999999 = vencido). Para dejar de aceptar aprobaciones: HERMES_SIMULADO=false.
# HERMES_SIMULADO=true
# Secreto de la huella (HMAC) de los códigos; cámbialo en producción. Los códigos nunca se guardan, solo su huella.
# HERMES_HUELLA_SECRETO=
